                "source": [
                    "# Comprehensive Dashboard Creation and Visualization\n",
                    "## Overview\n",
                    "**Building interactive dashboards for Treasury Analytics monitoring and reporting**\n",
                    "\n",
                    "## Introduction\n",
                    "This notebook provides comprehensive coverage of Dashboard Creation and Visualization techniques for Treasury Analytics. It focuses on creating interactive, real-time dashboards that enable stakeholders to monitor treasury performance, track key metrics, and make data-driven decisions.\n",
                    "\n",
                    "### Learning Objectives:\n",
                    "- Master dashboard creation for treasury monitoring\n",
                    "- Implement interactive visualization components\n",
                    "- Build real-time data updating systems\n",
                    "- Create comprehensive reporting frameworks\n",
                    "- Develop stakeholder-specific dashboard views\n",
                    "\n",
                    "### Prerequisites:\n",
                    "- Understanding of dashboard development principles\n",
                    "- Knowledge of interactive visualization libraries\n",
                    "- Familiarity with treasury reporting requirements\n",
                    "\n",
                    "### Step-by-Step Instructions:\n",
                    "1. Set up dashboard framework and layout\n",
                    "2. Create real-time data connection and updating systems\n",
                    "3. Build interactive visualization components\n",
                    "4. Implement filtering and navigation features\n",
                    "5. Design stakeholder-specific dashboard views\n",
                    "6. Create automated report generation capabilities\n",
                    "\n",
                    "### Key Features:\n",
                    "- ✅ Interactive dashboard creation\n",
                    "- ✅ Real-time data updating\n",
                    "- ✅ Multi-level visualizations\n",
                    "- ✅ Stakeholder-specific views\n",
                    "- ✅ Export and reporting capabilities\n",
                    "- ✅ Attribution support\n"
                ]
            },
            {
                "cell_type": "code",
                "execution_count": None,
                "metadata": {},
                "outputs": [],
                "source": [
                    "import pandas as pd\n",
                    "import numpy as np\n",
                    "import matplotlib.pyplot as plt\n",
                    "import seaborn as sns\n",
                    "import plotly.graph_objects as go\n",
                    "import plotly.express as px\n",
                    "from datetime import datetime, timedelta\n",
                    "\n",
                    "print('🚀 Treasury Analytics Notebook: Comprehensive Dashboard Creation')\n",
                    "print('✅ Environment ready for interactive dashboard development\n')\n",
                    "\n",
                    "# Generate treasury dashboard data\n",
                    "np.random.seed(42)\n",
                    "\n",
                    "def generate_dashboard_data():
",
 "# Generate comprehensive treasury metrics data\n",
 "n_periods = 365\n",
 "dates = pd.date_range('2024-01-01', periods=n_periods, freq='D')\n",
 "\n",
 "# Cash flow and liquidity metrics\n",
 "cash_flows = np.random.lognormal(8, 1.5, n_periods)\n",
 "cash_flows += np.random.normal(0, 10000, n_periods)\n",
 "\n",
 "# Investment portfolio values\n",
 "portfolio_values = 1000000 + np.cumsum(np.random.lognormal(0.5, 2, n_periods))\n",
 "\n",
 "# Risk metrics\n",
 "risk_scores = np.random.beta(1, 3, n_periods)\n",
 "\n",
 "# Transaction volumes by category\n",
 "transaction_categories = ['Treasury Operations', 'Investment Management', 'Risk Management', 'Compliance']\n",
 "transaction_data = {}
",
 "for cat in transaction_categories:
",
 "    transaction_data[f'{cat}_volume'] = np.random.lognormal(7, 1.2, n_periods)
",
 "\n",
 "# Regulatory compliance scores\n",
 "compliance_scores = np.random.beta(2, 1, n_periods)\n",
 "\n",
 "dashboard_data = {
",
 "    'date': dates,\n",
 "    'total_cash_flow': cash_flows,\n",
 "    'portfolio_value': portfolio_values,\n",
 "    'overall_risk_score': risk_scores,\n",
 "    'compliance_score': compliance_scores,\n",
 "    **{f'{cat}_volume': transaction_data[f'{cat}_volume'] for cat in transaction_categories}\n",
 "}\n",
 "\n",
 "dashboard_df = pd.DataFrame(dashboard_data)\n",
 "\n",
 "print('📊 Dashboard Data Overview:')\n",
 "print(f\"Date range: {dashboard_df['date'].min()} to {dashboard_df['date'].max()}\")\n",
 "print(f\"Total periods: {len(dashboard_df):,}\")\n",
 "print(f\"Average daily cash flow: ₹{dashboard_df['total_cash_flow'].mean():,.0f}\")\n",
 "print(f\"Portfolio value range: ₹{dashboard_df['portfolio_value'].min():,.0f} - ₹{dashboard_df['portfolio_value'].max():,.0f}\")\n",
 "print(f\"Average compliance score: {dashboard_df['compliance_score'].mean():.2f}\\n')\n",
 "\n",
 "print('🔍 Data Structure:')\n",
 "print(dashboard_df.head(3))\n"
                ]
            },
            {
                "cell_type": "code",
                "execution_count": None,
                "metadata": {},
                "outputs": [],
                "source": [
                    "# Dashboard Creation and Visualization Section\n",
                    "print('🔬 Dashboard Creation and Visualization Analysis:')\n",
                    "\n",
                    "# Create comprehensive dashboard layout\n",
                    "print('🎨 Dashboard Layout Creation:')\n",
                    "\n",
                    "# Main dashboard figure with multiple subplots\n",
 "fig = go.FigureWidget()\n",
 "\n",
 "# Add main cash flow chart\n",
 "fig.add_trace(go.Scatter(
",
 "    x=dashboard_df['date'],
",
 "    y=dashboard_df['total_cash_flow'],
",
 "    name='Total Cash Flow',
",
 "    line=dict(color='blue', width=2),
",
 "    hovertemplate='<b>Date</b>: %{x}<br><b>Cash Flow</b>: ₹%{y:,.0f}<extra></extra>'
",
 "))\n",
 "\n",
 "# Add portfolio value chart\n",
 "fig.add_trace(go.Scatter(
",
 "    x=dashboard_df['date'],
",
 "    y=dashboard_df['portfolio_value'],
",
 "    name='Portfolio Value',
",
 "    line=dict(color='green', width=2),
",
 "    yaxis='y2',
",
 "    hovertemplate='<b>Date</b>: %{x}<br><b>Portfolio Value</b>: ₹%{y:,.0f}<extra></extra>'
",
 "))\n",
 "\n",
 "# Add risk score chart\n",
 "fig.add_trace(go.Scatter(
",
 "    x=dashboard_df['date'],
",
 "    y=dashboard_df['overall_risk_score'],
",
 "    name='Risk Score',
",
 "    line=dict(color='red', width=2),
",
 "    yaxis='y3',
",
 "    hovertemplate='<b>Date</b>: %{x}<br><b>Risk Score</b>: %{y:.3f}<extra></extra>'
",
 "))\n",
 "\n",
 "# Add compliance chart\n",
 "fig.add_trace(go.Scatter(
",
 "    x=dashboard_df['date'],
",
 "    y=dashboard_df['compliance_score'],
",
 "    name='Compliance Score',
",
 "    line=dict(color='purple', width=2),
",
 "    yaxis='y4',
",
 "    hovertemplate='<b>Date</b>: %{x}<br><b>Compliance Score</b>: %{y:.3f}<extra></extra>'
",
 "))\n",
 "\n",
 "# Configure dual and triple y-axes\n",
 "fig.update_layout(
",
 "    title='Treasury Analytics Comprehensive Dashboard',
",
 "    xaxis_title='Date',
",
 "    yaxis=dict(title='Cash Flow (₹)', side='left'),
",
 "    yaxis2=dict(title='Portfolio Value (₹)', side='right', overlaying='y'),
",
 "    yaxis3=dict(title='Risk Score', side='left', overlaying='y', position=0.2),
",
 "    yaxis4=dict(title='Compliance Score', side='right', overlaying='y', position=0.8),
",
 "    hovermode='x unified',
",
 "    height=800,
",
 "    showlegend=True
",
 ")\n",
 "\n",
 "print('📊 Interactive Dashboard Created Successfully!')\n",
 "\n",
 "# Create additional dashboard components\n",
 "print('🎯 Additional Dashboard Components:')\n",
 "\n",
 "# Transaction breakdown pie chart\n",
 "latest_transactions = dashboard_df.iloc[-1]",
 "transaction_values = [latest_transactions[f'{cat}_volume'] for cat in transaction_categories]",
 "pie_chart = go.Figure(data=[go.Pie(labels=transaction_categories, values=transaction_values)])",
 "pie_chart.update_layout(title='Current Transaction Distribution')",
 "pie_chart.show()",
 "\n",
 "# Create summary metrics dashboard\n",
 "print('\n📋 Summary Metrics Dashboard:')
",
 "summary_metrics = {
",
 "    'total_cash_flow': dashboard_df['total_cash_flow'].sum(),
",
 "    'avg_portfolio_value': dashboard_df['portfolio_value'].mean(),
",
 "    'avg_risk_score': dashboard_df['overall_risk_score'].mean(),
",
 "    'overall_compliance': dashboard_df['compliance_score'].mean(),
",
 "}
",
 "print('Key Performance Indicators:')
",
 "for metric, value in summary_metrics.items():
",
 "    if 'cash_flow' in metric:",
 "        print(f\"  💰 {metric.replace('_', ' ').title()}: ₹{value:,.0f}\")\n",
 "    elif 'portfolio' in metric:",
 "        print(f\"  📈 {metric.replace('_', ' ').title()}: ₹{value:,.0f}\")\n",
 "    else:",
 "        print(f\"  📊 {metric.replace('_', ' ').title()}: {value:.3f}\")\n",
 "\n",
 "print('🎯 Comprehensive Dashboard Ready for Participant Use!')\n"
                ]
            }
