                    "# Complete Treasury Analytics Workflow Section\n",
 "print('🔬 Complete Treasury Analytics Workflow Execution:')
",
 "\n",
 "# Workflow Stage 1: Data Ingestion and Processing\n",
 "print('📥 Workflow Stage 1: Data Ingestion and Processing')
",
 "\n",
 "def process_treasury_data(df):
",
 "    print('🔄 Processing treasury data pipeline...')
",
 "    \n",
 "    # Data cleaning and validation\n",
 "    df_clean = df.copy()
",
 "    df_clean['date'] = pd.to_datetime(df_clean['date'])
",
 "    df_clean = df_clean.sort_values('date')
",
 "    \n",
 "    # Calculate derived metrics\n",
 "    df_clean['daily_change'] = df_clean['total_cash_flow'].pct_change()
",
 "    df_clean['portfolio_growth'] = df_clean['portfolio_value'].pct_change()
",
 "    df_clean['risk_category'] = pd.cut(df_clean['risk_score'], bins=[0, 0.3, 0.6, 1.0], labels=['Low', 'Medium', 'High'])
",
 "    # Calculate liquidity health score\n",
 "    df_clean['liquidity_health'] = (
",
 "        (df_clean['liquidity_ratio'] * 0.4) +
",
 "        (df_clean['compliance_score'] * 0.3) +
",
 "        (1 - df_clean['risk_score']) * 0.3
",
 "    )
",
 "    return df_clean\n",
 "\n",
 "processed_df = process_treasury_data(demo_df)\n",
 "\n",
 "print('✅ Data Processing Complete!')
",
 "\n",
 "# Workflow Stage 2: Analysis and Modeling\n",
 "print('🧮 Workflow Stage 2: Analysis and Modeling')
",
 "\n",
 "def execute_analytics_pipeline(df):
",
 "    print('🔬 Executing analytics pipeline...')
",
 "    \n",
 "    # Cash flow analysis\n",
 "    cash_flow_stats = {
",
 "        'total_volume': df['total_cash_flow'].sum(),
",
 "        'average_daily': df['total_cash_flow'].mean(),
",
 "        'volatility': df['total_cash_flow'].std(),
",
 "        'growth_rate': df['daily_change'].mean()
",
 "    }
",
 "    # Portfolio performance analysis\n",
 "    portfolio_stats = {
",
 "        'current_value': df['portfolio_value'].iloc[-1],
",
 "        'peak_value': df['portfolio_value'].max(),
",
 "        'trough_value': df['portfolio_value'].min(),
",
 "        'cagr': (df['portfolio_value'].iloc[-1] / df['portfolio_value'].iloc[0]) ** (1 / len(df)) - 1
",
 "    }
",
 "    # Risk analysis\n",
 "    risk_stats = {
",
 "        'average_risk': df['risk_score'].mean(),
",
 "        'high_risk_days': len(df[df['risk_score'] > 0.7]),
",
 "        'risk_trend': df['risk_score'].corr(df['liquidity_ratio'])
",
 "    }
",
 "    return cash_flow_stats, portfolio_stats, risk_stats\n",
 "\n",
 "cash_stats, port_stats, risk_stats = execute_analytics_pipeline(processed_df)\n",
 "\n",
 "print('📊 Analytics Pipeline Results:')
",
 "print(f\"  💰 Total Cash Flow: ₹{cash_stats['total_volume']:,.0f}\")
",
 "print(f\"  📈 Portfolio CAGR: {cash_stats['growth_rate']:.3f}\")
",
 "print(f\"  🎯 Risk-Return Correlation: {risk_stats['risk_trend']:.3f}\\n')\n",
 "\n",
 "# Workflow Stage 3: Visualization and Reporting\n",
 "print('📊 Workflow Stage 3: Visualization and Reporting')
",
 "\n",
 "def create_comprehensive_dashboard(df):
",
 "    print('🎨 Creating comprehensive analytics dashboard...')
",
 "    \n",
 "    fig = go.FigureWidget()
",
 "    \n",
 "    # Add cash flow trend\n",
 "    fig.add_trace(go.Scatter(
",
 "        x=df['date'],
",
 "        y=df['total_cash_flow'],
",
 "        name='Total Cash Flow',
",
 "        line=dict(color='blue', width=2),
",
 "        hovertemplate='<b>Date</b>: %{x}<br><b>Cash Flow</b>: ₹%{y:,.0f}<extra></extra>'
",
 "    ))
",
 "    # Add portfolio value overlay\n",
 "    fig.add_trace(go.Scatter(
",
 "        x=df['date'],
",
 "        y=df['portfolio_value'] / 1000000,  # Convert to millions
",
 "        name='Portfolio Value (Millions)',
",
 "        line=dict(color='green', width=2),
",
 "        yaxis='y2',
",
 "        hovertemplate='<b>Date</b>: %{x}<br><b>Portfolio</b>: $%{y:.1f}M<extra></extra>'
",
 "    ))
",
 "    \n",
 "    fig.update_layout(
",
 "        title='Complete Treasury Analytics Dashboard - End-to-End Workflow Demo',
",
 "        xaxis_title='Date',
",
 "        yaxis=dict(title='Cash Flow (₹)', side='left'),
",
 "        yaxis2=dict(title='Portfolio Value (Millions)', side='right', overlaying='y'),
",
 "        hovermode='x unified',
",
 "        height=600,
",
 "        showlegend=True
",
 "    )
",
 "    \n",
 "    return fig\n",
 "\n",
 "dashboard = create_comprehensive_dashboard(processed_df)\n",
 "\n",
 "print('✅ Dashboard Created Successfully!')
",
 "\n",
